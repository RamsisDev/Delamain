{
  "name": "delamain",
  "private": true,
  "description": "Multi-provider orchestration harness for VS Code",
  "license": "PolyForm-Small-Business-1.0.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/adapters",
    "packages/webview",
    "packages/extension"
  ],
  "scripts": {
    "build": "npm run build -w @delamain/webview && npm run build -w delamain-harness",
    "typecheck": "tsc -p packages/core && tsc -p packages/adapters && tsc -p packages/webview && tsc -p packages/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "npm run build -w @delamain/webview && playwright test",
    "setup:cli": "node scripts/setup-cli.mjs",
    "cli:codex": "node scripts/cli.mjs codex",
    "cli:claude": "node scripts/cli.mjs claude",
    "schema": "npm run schema -w delamain-harness",
    "package": "npm run package -w delamain-harness"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "cross-spawn": "^7.0.6",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
